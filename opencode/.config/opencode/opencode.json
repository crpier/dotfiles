{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 256000
          }
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "codesearch": "allow",
    "doom_loop": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": "allow",
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
